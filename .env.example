# Supabase Configuration
# Get these from your Supabase project settings at https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini API Key
# Get this from Google AI Studio at https://aistudio.google.com/app/apikey
# NOTE: VITE_* vars are embedded in the public frontend bundle. For a hosted
# build, prefer per-user keys entered in the in-app Key Wallet (encrypted at
# rest) or a backend proxy instead of shipping a shared key here.
VITE_GEMINI_API_KEY=your_gemini_api_key

# Public base path for the build. Defaults to '/Gemini-Visual-Studio/' (GitHub
# Pages). Set to '/' for root-domain hosts like Vercel (vercel.json already does
# this for Vercel deploys).
# VITE_BASE_PATH=/
